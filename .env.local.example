# ==============================================================================
# HALALA FOOD - LARAVEL BACKEND ENVIRONMENT (PENGEMBANGAN / LOCAL)
# ==============================================================================
# Salin file ini menjadi ".env" saat menjalankan di komputer pengembang:
# cp .env.local.example .env
# php artisan key:generate
# php artisan jwt:secret

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEBUG
# ------------------------------------------------------------------------------
APP_NAME="Halala Food"
APP_ENV=local
# Wajib digenerate menggunakan "php artisan key:generate"
APP_KEY=base64:nm5AHys9mBJYdX8cRuXPJs3KLDqLN6SPlaYz7s8w7DA=
# Nyalakan debug di local untuk mempermudah perbaikan error dan melihat stack trace
APP_DEBUG=true
# URL akses web admin di komputer lokal (Laravel Herd atau artisan serve)
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Di local, level 'debug' mencatat seluruh query dan log detail
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (LOCAL MYSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_halala_food
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SESSION & CACHE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 5. QUEUE CONNECTION
# ------------------------------------------------------------------------------
# Jalankan "php artisan queue:work" di terminal terpisah
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 6. LARAVEL REVERB (WEBSOCKET REAL-TIME BROADCASTING) - LOCAL
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

# Kunci Reverb lokal (bebas, tetapi wajib sama persis dengan yang ada di Flutter .env)
REVERB_APP_ID=halalafood
REVERB_APP_KEY=halalafoodkey123
REVERB_APP_SECRET=halalafoodsecret123

# Host & Port lokal tempat service "php artisan reverb:start" berjalan
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Konfigurasi Reverb untuk frontend admin (Vite / Echo / Livewire)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 7. JWT AUTHENTICATION (MOBILE API)
# ------------------------------------------------------------------------------
# Kunci enkripsi token login JWT mobile (generate via: php artisan jwt:secret)
JWT_SECRET=MD9MtgfTvYgfpAG04KscOd2mbwDmXwVdsQmAwh4v30EWphpC9dKoyVnLIbFx6eN0
JWT_ALGO=HS256

# ------------------------------------------------------------------------------
# 8. MAIL CONFIGURATION (LOCAL LOGGING)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@halalafood.test"
MAIL_FROM_NAME="${APP_NAME}"
